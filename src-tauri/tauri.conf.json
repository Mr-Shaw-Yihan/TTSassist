{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TTSassist",
  "version": "1.8.7",
  "identifier": "com.voiceassist.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TTSassist",
        "width": 420,
        "height": 660,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "quick_input",
        "title": "",
        "width": 360,
        "height": 220,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "resizable": false
      },
      {
        "label": "floating_ball",
        "title": "",
        "width": 56,
        "height": 56,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "transparent": true,
        "skipTaskbar": true
      },
      {
        "label": "subtitle_window",
        "title": "",
        "width": 760,
        "height": 240,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/plugins/*.zip"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
