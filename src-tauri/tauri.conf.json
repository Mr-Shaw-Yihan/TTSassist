{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TTSassist",
  "version": "1.5.0",
  "identifier": "com.voiceassist.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TTSassist",
        "width": 420,
        "height": 660,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true
      },
      {
        "label": "quick_input",
        "title": "",
        "width": 360,
        "height": 150,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/plugins/*.zip"]
  }
}
